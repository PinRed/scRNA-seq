rand_normal_hiseq <- expr_normal_hiseq[, sample(ncol(expr_normal_hiseq), num_normal)]
rand_tumor_hiseq  <- expr_tumor_hiseq[, sample(ncol(expr_tumor_hiseq), num_tumor)]
expr_data <- cbind(rand_normal_hiseq, rand_tumor_hiseq)
if (is.null(rownames(expr_data))) stop("expr_data lacks rownames (gene IDs)")
# --- DEA ---
sample_groups <- factor(c(rep("Normal", ncol(rand_normal_hiseq)), rep("Tumor", ncol(rand_tumor_hiseq))),
levels = c("Normal", "Tumor"))
design <- model.matrix(~0 + sample_groups)
colnames(design) <- c("Normal", "Tumor")
fit <- lmFit(expr_data, design)
contrast.matrix <- makeContrasts(Tumor_vs_Normal = Tumor - Normal, levels = design)
fit2 <- contrasts.fit(fit, contrast.matrix)
fit2 <- eBayes(fit2)
dea_results <- topTable(fit2, coef="Tumor_vs_Normal", number=Inf, sort.by="none")
# --- GSEA ---
gene_list <- dea_results$t
names(gene_list) <- rownames(dea_results)
gene_list_sorted <- sort(gene_list, decreasing = TRUE)
fgsea_res <- fgsea(
pathways = kegg_gene_sets_filtered,
stats = gene_list_sorted,
minSize = 10,
maxSize = 500,
nperm = 1000
)
fgsea_res_df <- as.data.frame(fgsea_res) %>% arrange(padj, desc(abs(NES)))
# --- 找出 padj 最小的 pathway（最顯著的）---
sig_pathways <- fgsea_res_df %>%
filter(padj == min(padj, na.rm = TRUE)) %>%
pull(pathway) %>%
na.omit() %>%
unique()
if (length(sig_pathways) > 0) {
for (pw in sig_pathways) {
if(!is.null(pw)&&pw!=""){
if(!pw %in% names(pathway_counts)){
pathway_counts[[pw]] <- 1
}
else{
pathway_counts[[pw]] <- pathway_counts[[pw]] + 1
}
}
}
}
print(pathway_counts)
}
# 存入結果
pathway_counts_all[[paste0("r_", r)]] <- pathway_counts
}
